# Copier en .env.local (jamais commité). Les vraies valeurs vivent dans le gestionnaire de secrets.
NODE_ENV=development
API_URL=http://localhost:4000
DATABASE_URL=postgresql://livi:livi-dev-uniquement@localhost:5432/livi
REDIS_URL=redis://localhost:6379
# Authentification
APPLE_TEAM_ID=
APPLE_CLIENT_ID=fr.livi.app
APPLE_KEY_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
EMAIL_FROM=no-reply@livi.app
SMTP_URL=smtp://localhost:1025
SESSION_SECRET=
# IA (passerelle côté serveur uniquement)
ANTHROPIC_API_KEY=
# Données de marché et agrégation (fournisseurs sous licence)
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
AGGREGATOR_PROVIDER=
AGGREGATOR_CLIENT_ID=
AGGREGATOR_CLIENT_SECRET=
# Paiements
STRIPE_SECRET_KEY=
APP_STORE_SHARED_SECRET=
# Observabilité
SENTRY_DSN=
LOG_LEVEL=info
